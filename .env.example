# Akaion Runner Environment Variables

# Akaion Cloud
AKAION_API_KEY=your_api_key_here
AKAION_API_URL=https://api.akaion.com
AKAION_RUNNER_ID=auto_generated

# AI Providers (optional - use if not using Akaion AI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Development
AKAION_DEV_MODE=false
AKAION_LOG_LEVEL=INFO
