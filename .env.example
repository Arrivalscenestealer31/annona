# Akaion Runner Environment Variables

# Akaion Cloud - Backend Services (via Reverse Proxy)
AKAION_API_KEY=your_api_key_here
AKAION_RUNNER_ID=auto_generated

# Backend URLs (Reverse Proxy - api.akaion.com)
AKAION_MAIN_URL=https://api.akaion.com/api/service1
AKAION_AI_URL=https://api.akaion.com/api/service4
AKAION_CALENDAR_URL=https://api.akaion.com/api/service2
AKAION_COT_URL=https://api.akaion.com/api/service3

# AI Providers (optional - use if not using Akaion AI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Development
AKAION_DEV_MODE=false
AKAION_LOG_LEVEL=INFO
