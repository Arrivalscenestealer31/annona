; Architectural contracts, enforced in CI.
;
; These are not style rules. They are the mechanically checkable half of the
; claims made in docs/design/sovereign-runtime.md: if the agent loop cannot
; import a provider SDK, then "the loop is provider-agnostic" is a fact rather
; than an intention.
;
; Run with:  make contracts     (or: lint-imports)

[importlinter]
root_packages =
    runner
include_external_packages = True

; ─────────────────────────────────────────────────────────────────────────────
; L0 is the innermost layer: ports and types, no dependencies on the rest.
; ─────────────────────────────────────────────────────────────────────────────
[importlinter:contract:kernel-is-innermost]
name = L0 kernel does not depend on outer layers
type = layers
layers =
    runner.capability
    runner.kernel

[importlinter:contract:agent-above-kernel]
name = L3 agent depends only inward on L0
type = layers
layers =
    runner.agent
    runner.kernel

; ─────────────────────────────────────────────────────────────────────────────
; The loop talks to ports, never to adapters. This is what lets Phase 1 slot a
; perimeter between them without touching either side.
; ─────────────────────────────────────────────────────────────────────────────
[importlinter:contract:agent-and-capability-are-independent]
name = L3 agent and L1 capability do not know about each other
type = independence
modules =
    runner.agent
    runner.capability

; ─────────────────────────────────────────────────────────────────────────────
; Provider isolation. Only L1 adapters may touch a vendor SDK.
; ─────────────────────────────────────────────────────────────────────────────
[importlinter:contract:kernel-has-no-vendors]
name = L0 kernel imports no provider SDK
type = forbidden
source_modules =
    runner.kernel
forbidden_modules =
    anthropic
    openai
    google
    httpx

[importlinter:contract:agent-has-no-vendors]
name = L3 agent loop imports no provider SDK
type = forbidden
source_modules =
    runner.agent
forbidden_modules =
    anthropic
    openai
    google
    httpx

; ─────────────────────────────────────────────────────────────────────────────
; L2 — the perimeter: policy, placement, audit.
;
; The decision layer must not be able to reach an adapter. If it could, the
; obvious shortcut ("no permitted substrate is up, so call the provider
; directly") would be one import away, and no reviewer would find it. Keeping
; the layers apart is what makes "failover cannot widen the permitted set" a
; structural property rather than a promise about the current code.
; ─────────────────────────────────────────────────────────────────────────────
[importlinter:contract:policy-above-kernel]
name = L2 policy depends only inward on L0
type = layers
layers =
    runner.policy
    runner.kernel

[importlinter:contract:placement-above-policy]
name = L2 placement depends on policy and the kernel, never outward
type = layers
layers =
    runner.placement
    runner.policy
    runner.kernel

[importlinter:contract:audit-is-independent]
name = L2 audit depends on nothing but the kernel
type = layers
layers =
    runner.audit
    runner.kernel

[importlinter:contract:perimeter-knows-no-adapters]
name = L2 policy, placement and audit cannot reach an L1 adapter
type = forbidden
source_modules =
    runner.policy
    runner.placement
    runner.audit
forbidden_modules =
    runner.capability
    runner.agent
    runner.tools
    runner.brain
    runner.sync

[importlinter:contract:perimeter-has-no-vendors]
name = L2 imports no provider SDK
type = forbidden
source_modules =
    runner.policy
    runner.audit
forbidden_modules =
    anthropic
    openai
    google
    httpx
