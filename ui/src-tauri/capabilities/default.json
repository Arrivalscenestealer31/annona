{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Annona: spawn the daemon sidecar, control the main window, check for updates.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:default",
    "process:allow-restart",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/annona",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-open",
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "name": "binaries/annona",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
